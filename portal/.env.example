# Copy to .env for local development (netlify dev loads it automatically).
# In production, set these in Netlify: Site configuration -> Environment variables.

# Password you and Matt use to log in to the portal
FAMILY_PASSWORD=change-me

# Secret the ESP32 sends in the X-Device-Key header. Any long random string.
DEVICE_KEY=change-me-too

# Used to sign login cookies. Any long random string.
SESSION_SECRET=change-me-three

# Timezone used to decide what "today" is
TIMEZONE=America/New_York
